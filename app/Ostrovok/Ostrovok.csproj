<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Ostrovok</AssemblyName>
    <RootNamespace>Ostrovok</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Product>Островок</Product>
    <AssemblyTitle>Островок</AssemblyTitle>
    <Version>0.2.2</Version>
    <NoWarn>$(NoWarn);CA1416;WFO1000;MSB3277</NoWarn>
    <!-- the project folder path is long; keep build output short to stay under MAX_PATH -->
    <BaseOutputPath>$(TEMP)\ostrovok-build\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ui\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Data.OleDb" Version="11.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="11.0.0" />
  </ItemGroup>

</Project>
